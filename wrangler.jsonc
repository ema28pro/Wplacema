{
  "name": "wplacema",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}

